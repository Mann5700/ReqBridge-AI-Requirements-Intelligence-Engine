# ReqBridge Environment Configuration
# Copy to .env and fill in values

# Database (local SQLite file)
DATABASE_URL=sqlite+aiosqlite:///./reqbridge.db

# LLM (OpenAI-compatible endpoint)
# Default: local Ollama — free, offline, no API key required.
#   1) Install Ollama:  https://ollama.com/download
#   2) Pull a model:    ollama pull llama3.1:8b
#   3) Leave LLM_API_KEY blank.
# To use a remote provider instead (OpenAI / Azure OpenAI / etc.) point
# LLM_BASE_URL at it and set LLM_API_KEY.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=
LLM_REQUEST_TIMEOUT=120

# Azure DevOps (only required if you push work items to ADO)
ADO_ORG_URL=https://dev.azure.com/{your-org}
ADO_PAT=your-personal-access-token
ADO_PROJECT=your-default-project

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Confidence Thresholds
HITL_CONFIDENCE_THRESHOLD=0.7
AUTO_APPROVE_THRESHOLD=0.9

# MCP Server
REQBRIDGE_API_URL=http://localhost:8000
